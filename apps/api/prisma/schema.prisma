generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
}

model School {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String             @unique @db.VarChar(80)
  name          String             @db.VarChar(160)
  logoUrl       String?
  theme         Json?
  settings      Json?
  isActive      Boolean            @default(true)
  memberships   SchoolMembership[]
  roles         Role[]
  academicYears AcademicYear[]
  classes       Class[]
  subjects      Subject[]
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
}

model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String             @unique @db.VarChar(254)
  displayName       String             @db.VarChar(160)
  platformRole      PlatformRole?
  isActive          Boolean            @default(true)
  schoolMemberships SchoolMembership[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
}

model SchoolMembership {
  id                 String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String                      @db.Uuid
  userId             String                      @db.Uuid
  isActive           Boolean                     @default(true)
  school             School                      @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles              MembershipRole[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  children           ParentStudentRelationship[] @relation("ParentMembership")
  guardians          ParentStudentRelationship[] @relation("StudentMembership")
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@index([userId])
}

model Role {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @db.Uuid

  code        String           @db.VarChar(64)
  name        String           @db.VarChar(160)
  isActive    Boolean          @default(true)
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, code])
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String     @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Cascade, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String           @db.Uuid
  membershipId String           @db.Uuid
  roleId       String           @db.Uuid
  membership   SchoolMembership @relation(fields: [schoolId, membershipId], references: [schoolId, id], onDelete: Cascade, onUpdate: Restrict)
  role         Role             @relation(fields: [schoolId, roleId], references: [schoolId, id], onDelete: Cascade, onUpdate: Restrict)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, membershipId, roleId])
  @@index([schoolId, roleId])
}

model AcademicYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid
  name      String    @db.VarChar(80)
  startsOn  DateTime  @db.Date
  endsOn    DateTime  @db.Date
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sections  Section[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, name])
}

model Class {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @db.Uuid
  code      String    @db.VarChar(64)
  name      String    @db.VarChar(120)
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sections  Section[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, code])
}

model Section {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String              @db.Uuid
  academicYearId     String              @db.Uuid
  classId            String              @db.Uuid
  name               String              @db.VarChar(80)
  academicYear       AcademicYear        @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  class              Class               @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, id])
  @@unique([schoolId, academicYearId, classId, name])
  @@index([schoolId, classId])
}

model Subject {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId           String              @db.Uuid
  code               String              @db.VarChar(64)
  name               String              @db.VarChar(120)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teacherAssignments TeacherAssignment[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, id])
  @@unique([schoolId, code])
}

model Enrollment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String           @db.Uuid
  academicYearId      String           @db.Uuid
  sectionId           String           @db.Uuid
  studentMembershipId String           @db.Uuid
  section             Section          @relation(fields: [schoolId, academicYearId, sectionId], references: [schoolId, academicYearId, id], onDelete: Restrict, onUpdate: Restrict)
  student             SchoolMembership @relation(fields: [schoolId, studentMembershipId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, academicYearId, studentMembershipId])
  @@index([schoolId, academicYearId, sectionId])
  @@index([schoolId, studentMembershipId])
}

model TeacherAssignment {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String           @db.Uuid
  sectionId           String           @db.Uuid
  subjectId           String           @db.Uuid
  teacherMembershipId String           @db.Uuid
  section             Section          @relation(fields: [schoolId, sectionId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  subject             Subject          @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  teacher             SchoolMembership @relation(fields: [schoolId, teacherMembershipId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, sectionId, subjectId, teacherMembershipId])
  @@index([schoolId, subjectId])
  @@index([schoolId, teacherMembershipId])
}

model ParentStudentRelationship {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId            String           @db.Uuid
  parentMembershipId  String           @db.Uuid
  studentMembershipId String           @db.Uuid
  parent              SchoolMembership @relation("ParentMembership", fields: [schoolId, parentMembershipId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  student             SchoolMembership @relation("StudentMembership", fields: [schoolId, studentMembershipId], references: [schoolId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([schoolId, parentMembershipId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}
