# Copy to apps/api/.env.local and fill in. Never commit real values.

API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated frontend origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string. Percent-encode reserved characters in credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/school_lms_db?schema=public

# ---------- Razorpay (fee payments) ----------
# Leave blank until the Razorpay account is ready.
# Dashboard → Settings → API Keys. Use rzp_test_… keys while testing.
RAZORPAY_KEY_ID=
# Secret key: server only. Used to create orders and verify payment signatures.
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Used to verify webhook calls (payment.captured).
RAZORPAY_WEBHOOK_SECRET=
