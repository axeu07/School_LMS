# Copy to apps/api/.env.local and fill in. Never commit real values.

API_HOST=127.0.0.1
API_PORT=3001
# Comma-separated frontend origins allowed by CORS.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string. Percent-encode reserved characters in credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/school_lms_db?schema=public

# ---------- Razorpay (fee payments) ----------
# Leave blank until the Razorpay account is ready.
# Dashboard → Settings → API Keys. Use rzp_test_… keys while testing.
RAZORPAY_KEY_ID=
# Secret key: server only. Used to create orders and verify payment signatures.
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Used to verify webhook calls (payment.captured).
RAZORPAY_WEBHOOK_SECRET=

# ---------- Sign-in ----------
# Signs access tokens. At least 32 random characters; different per environment.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Send the refresh cookie over HTTPS only. Defaults to true when NODE_ENV=production.
AUTH_COOKIE_SECURE=
# Number of reverse proxies in front of the API (0 locally). Lets rate limits see real client IPs.
TRUST_PROXY=0

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST blank to print emails to the API console in development.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to recipients, e.g. ACADMAXIS <no-reply@yourdomain.com>
MAIL_FROM=
