# Optional browser-visible API base URL for future API calls.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api

# Razorpay public Key ID for Checkout (rzp_test_… or rzp_live_…). Leave blank
# until the account is ready. Only the public key belongs here; the key secret
# and webhook secret go in apps/api/.env.local.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
